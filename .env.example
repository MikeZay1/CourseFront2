# База пути для GitHub Pages: имя репозитория со слэшами, например /CourseFront2/
# Локально часто оставляют VITE_BASE_URL=/
# В GitHub Actions base также подставляется из GITHUB_REPOSITORY (см. vite.config.ts)
VITE_BASE_URL=/

# true — встроенный мок в браузере (localStorage). false — реальные HTTP-запросы.
VITE_USE_MOCK=true

# Полный URL API без завершающего слэша, например https://api.example.com
# При VITE_DEV_PROXY=true можно оставить пустым — запросы идут на тот же origin, Vite проксирует на VITE_API_PROXY_TARGET.
VITE_API_URL=

# Режим разработки: прокси /auth, /lessons, /dashboard → локальный или удалённый бэкенд (обход CORS).
VITE_DEV_PROXY=false
VITE_API_PROXY_TARGET=http://localhost:4000

# Таймаут Axios для реального API (мс)
VITE_API_TIMEOUT_MS=15000

# Порт локального API (только для npm run api)
# API_PORT=4000
